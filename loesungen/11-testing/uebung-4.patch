+func TestRunContinuesWhenSaveFails(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		store := &fakeStore{saveErr: errors.New("disk full")}
+		for i := range 5 {
+			store.pending = append(store.pending, monitor.Target{ID: int64(i + 1)})
+		}
+		// saveFailures is a process-wide expvar counter. Compare deltas,
+		// it cannot be reset per test.
+		failuresBefore := saveFailures.Value()
+
+		ctx, cancel := context.WithCancel(t.Context())
+		s := New(store, fakeChecker{}, discardLogger(), 3, time.Second)
+		done := make(chan struct{})
+		go func() {
+			s.Run(ctx)
+			close(done)
+		}()
+
+		// 5 checks of 100ms on 3 workers need 2 rounds = 200ms.
+		time.Sleep(200 * time.Millisecond)
+		synctest.Wait()
+		if got := store.attemptCount(); got != 5 {
+			t.Fatalf("after 200ms save attempts = %d, want 5", got)
+		}
+
+		// Failed saves must not stop the scheduler: targets that become
+		// due later are claimed on the next tick (1s) and checked (100ms).
+		store.add(monitor.Target{ID: 6}, monitor.Target{ID: 7})
+		time.Sleep(900 * time.Millisecond)
+		synctest.Wait()
+		if got := store.attemptCount(); got != 7 {
+			t.Fatalf("after 1.1s save attempts = %d, want 7", got)
+		}
+		if got := store.savedCount(); got != 0 {
+			t.Errorf("saved = %d, want 0", got)
+		}
+		if got := saveFailures.Value() - failuresBefore; got != 7 {
+			t.Errorf("upwatch_save_failures_total grew by %d, want 7", got)
+		}
+
+		cancel()
+		<-done
+	})
+}

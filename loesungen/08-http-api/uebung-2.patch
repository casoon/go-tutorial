+func TestCreateTargetRequiresJSON(t *testing.T) {
+	srv := newServer(t)
+
+	tests := []struct {
+		contentType string
+		wantStatus  int
+	}{
+		{"application/x-www-form-urlencoded", http.StatusUnsupportedMediaType}, // curl -d
+		{"text/plain", http.StatusUnsupportedMediaType},
+		{"", http.StatusUnsupportedMediaType},
+		{"application/json; charset=utf-8", http.StatusCreated},
+		{"Application/JSON", http.StatusCreated}, // media types are case-insensitive
+	}
+	for i, tt := range tests {
+		t.Run(tt.contentType, func(t *testing.T) {
+			body := fmt.Sprintf(`{"url":"https://example.com/%d"}`, i)
+			req, err := http.NewRequestWithContext(t.Context(), "POST", srv.URL+"/targets", strings.NewReader(body))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if tt.contentType != "" {
+				req.Header.Set("Content-Type", tt.contentType)
+			}
+			resp, err := http.DefaultClient.Do(req)
+			if err != nil {
+				t.Fatal(err)
+			}
+			resp.Body.Close()
+			if resp.StatusCode != tt.wantStatus {
+				t.Errorf("status = %d, want %d", resp.StatusCode, tt.wantStatus)
+			}
+		})
+	}
+}

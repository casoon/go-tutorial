+
+func TestMuxErrorsAreJSON(t *testing.T) {
+	srv := newServer(t)
+
+	tests := []struct {
+		name, method, path string
+		wantStatus         int
+		wantBody           string
+		wantAllow          string
+	}{
+		{"unknown path", "GET", "/nope", 404, `{"error":"not found"}`, ""},
+		{"wrong method", "PUT", "/targets/1", 405, `{"error":"method not allowed"}`, "DELETE, GET, HEAD"},
+		// Written by getTarget, not by the mux: must stay as it is.
+		{"unknown target", "GET", "/targets/99", 404, `{"error":"target not found"}`, ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			resp, body := do(t, tt.method, srv.URL+tt.path, "")
+			if resp.StatusCode != tt.wantStatus {
+				t.Fatalf("status = %d, want %d", resp.StatusCode, tt.wantStatus)
+			}
+			if ct := resp.Header.Get("Content-Type"); ct != "application/json" {
+				t.Errorf("Content-Type = %q, want application/json", ct)
+			}
+			if got := strings.TrimSpace(body); got != tt.wantBody {
+				t.Errorf("body = %s, want %s", got, tt.wantBody)
+			}
+			if got := resp.Header.Get("Allow"); got != tt.wantAllow {
+				t.Errorf("Allow = %q, want %q", got, tt.wantAllow)
+			}
+		})
+	}
+}

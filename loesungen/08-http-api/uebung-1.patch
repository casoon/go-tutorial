+
+func TestExampleHeader(t *testing.T) {
+	h := NewHandler(NewStore())
+	for _, tt := range []struct {
+		method, path string
+		wantStatus   int
+	}{
+		{"GET", "/healthz", 200},
+		{"GET", "/nope", 404},       // written by the mux
+		{"PUT", "/targets/1", 405},  // written by the mux
+		{"GET", "/targets/99", 404}, // written by our handler
+	} {
+		rec := httptest.NewRecorder()
+		h.ServeHTTP(rec, httptest.NewRequest(tt.method, tt.path, nil))
+		if rec.Code != tt.wantStatus {
+			t.Errorf("%s %s: status %d, want %d", tt.method, tt.path, rec.Code, tt.wantStatus)
+		}
+		if got := rec.Header().Get("X-Upwatch-Example"); got != "1" {
+			t.Errorf("%s %s: X-Upwatch-Example = %q, want 1", tt.method, tt.path, got)
+		}
+	}
+}

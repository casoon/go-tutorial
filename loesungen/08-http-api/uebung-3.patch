+func TestUpdateInterval(t *testing.T) {
+	s := newStore(t)
+	ctx := t.Context()
+	target := mustCreate(t, s, "https://example.com", 24*time.Hour)
+
+	// The first check is due at once; claiming it moves the next one 24h out.
+	now := time.Now().Add(time.Second)
+	if due, err := s.ClaimDue(ctx, now, 10); err != nil || len(due) != 1 {
+		t.Fatalf("ClaimDue = %v, %v; want 1 target", due, err)
+	}
+
+	got, err := s.UpdateInterval(ctx, target.ID, 10*time.Second)
+	if err != nil {
+		t.Fatalf("UpdateInterval: %v", err)
+	}
+	if got.Interval != 10*time.Second || got.URL != target.URL || !got.CreatedAt.Equal(target.CreatedAt) {
+		t.Errorf("UpdateInterval = %+v, want %+v with a 10s interval", got, target)
+	}
+
+	// The shorter interval applies right away, not after the old 24h.
+	due, err := s.ClaimDue(ctx, now.Add(11*time.Second), 10)
+	if err != nil || len(due) != 1 {
+		t.Fatalf("ClaimDue after update = %v, %v; want 1 target", due, err)
+	}
+
+	if _, err := s.UpdateInterval(ctx, 99, time.Minute); !errors.Is(err, monitor.ErrNotFound) {
+		t.Errorf("UpdateInterval(99) err = %v, want ErrNotFound", err)
+	}
+}

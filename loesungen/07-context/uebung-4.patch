 }
+
+// A check finishes at 100ms, its INSERT takes 10ms, and the cancel arrives
+// at 105ms, in the middle of the INSERT. The writer saves with a context
+// that is not canceled together with ctx, so the result still lands.
+func TestRunSavesResultFinishedBeforeCancel(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		store := &fakeStore{
+			pending:   []monitor.Target{{ID: 1}},
+			saveDelay: 10 * time.Millisecond,
+		}
+		ctx, cancel := context.WithCancel(t.Context())
+		s := New(store, fakeChecker{}, discardLogger(), 1, time.Second)
+
+		done := make(chan struct{})
+		go func() {
+			s.Run(ctx)
+			close(done)
+		}()
+
+		time.Sleep(105 * time.Millisecond)
+		cancel()
+		<-done
+
+		if got := store.savedCount(); got != 1 {
+			t.Fatalf("saved = %d, want 1", got)
+		}
+	})
+}

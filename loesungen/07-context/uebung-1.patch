+package main
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"testing/synctest"
+	"time"
+)
+
+func TestErrors(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		start := time.Now()
+		if err := withTimeout(); !errors.Is(err, context.DeadlineExceeded) {
+			t.Errorf("withTimeout() = %v, want context.DeadlineExceeded", err)
+		}
+		if d := time.Since(start); d != 50*time.Millisecond {
+			t.Errorf("withTimeout took %s, want 50ms", d)
+		}
+
+		start = time.Now()
+		if err := withCancel(); !errors.Is(err, context.Canceled) {
+			t.Errorf("withCancel() = %v, want context.Canceled", err)
+		}
+		if d := time.Since(start); d != 10*time.Millisecond {
+			t.Errorf("withCancel took %s, want 10ms", d)
+		}
+	})
+}

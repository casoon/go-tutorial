+// Command abbruch ends a context once by its deadline and once by an
+// explicit cancel, and prints the error each one reports.
+package main
+
+import (
+	"context"
+	"fmt"
+	"time"
+)
+
+// wait blocks until ctx ends or a second has passed and returns ctx.Err().
+func wait(ctx context.Context) error {
+	select {
+	case <-ctx.Done():
+	case <-time.After(time.Second):
+	}
+	return ctx.Err()
+}
+
+// withTimeout lets the deadline end the context after 50ms.
+func withTimeout() error {
+	ctx, cancel := context.WithTimeout(context.Background(), 50*time.Millisecond)
+	defer cancel()
+	return wait(ctx)
+}
+
+// withCancel ends the context from another goroutine after 10ms.
+func withCancel() error {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	go func() {
+		time.Sleep(10 * time.Millisecond)
+		cancel()
+	}()
+	return wait(ctx)
+}
+
+func main() {
+	start := time.Now()
+	err := withTimeout()
+	fmt.Printf("WithTimeout: %v after %s\n", err, time.Since(start).Round(time.Millisecond))
+
+	start = time.Now()
+	err = withCancel()
+	fmt.Printf("WithCancel:  %v after %s\n", err, time.Since(start).Round(time.Millisecond))
+}

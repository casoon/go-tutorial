--- a/internal/check/check_test.go
+++ b/internal/check/check_test.go
@@ -130,3 +130,25 @@ func TestIsPublic(t *testing.T) {
 		}
 	}
 }
+
+// The caller's own deadline runs out before the checker's timeout. That is
+// the caller giving up, not a slow site, so Check must return an error
+// instead of a result with "timeout".
+func TestCheckCallerDeadline(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		<-r.Context().Done()
+	}))
+	defer srv.Close()
+
+	ctx, cancel := context.WithTimeout(t.Context(), 20*time.Millisecond)
+	defer cancel()
+
+	c := New(NewClient(true), time.Second)
+	res, err := c.Check(ctx, monitor.Target{URL: srv.URL})
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Errorf("err = %v, want context.DeadlineExceeded", err)
+	}
+	if res.Err != "" {
+		t.Errorf("res.Err = %q, want it empty: there is no outcome to record", res.Err)
+	}
+}

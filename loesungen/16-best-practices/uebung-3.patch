diff --git a/internal/retention/retention.go b/internal/retention/retention.go
new file mode 100644
index 0000000..546ee76
--- /dev/null
+++ b/internal/retention/retention.go
@@ -0,0 +1,41 @@
+// Package retention periodically deletes old check results, so the
+// results table does not grow without bound.
+package retention
+
+import (
+	"context"
+	"log/slog"
+	"time"
+)
+
+// Store is what retention needs from persistence.
+type Store interface {
+	DeleteResultsBefore(ctx context.Context, before time.Time, batch int) (int64, error)
+}
+
+// batchSize bounds how many rows a single DELETE removes, and with it
+// how long SQLite's write lock is held at a time.
+const batchSize = 1000
+
+// Run deletes results older than maxAge right away and then every
+// interval. It blocks until ctx is canceled.
+func Run(ctx context.Context, store Store, logger *slog.Logger, maxAge, interval time.Duration) {
+	ticker := time.NewTicker(interval)
+	defer ticker.Stop()
+
+	for {
+		n, err := store.DeleteResultsBefore(ctx, time.Now().Add(-maxAge), batchSize)
+		switch {
+		case err != nil && ctx.Err() == nil:
+			logger.Error("delete old results", "err", err)
+		case n > 0:
+			logger.Info("deleted old results", "count", n, "max_age", maxAge)
+		}
+
+		select {
+		case <-ticker.C:
+		case <-ctx.Done():
+			return
+		}
+	}
+}
diff --git a/internal/retention/retention_test.go b/internal/retention/retention_test.go
new file mode 100644
index 0000000..82c02c6
--- /dev/null
+++ b/internal/retention/retention_test.go
@@ -0,0 +1,62 @@
+package retention
+
+import (
+	"context"
+	"io"
+	"log/slog"
+	"sync"
+	"testing"
+	"testing/synctest"
+	"time"
+)
+
+// fakeStore records the cutoff of every call.
+type fakeStore struct {
+	mu      sync.Mutex
+	cutoffs []time.Time
+}
+
+func (f *fakeStore) DeleteResultsBefore(_ context.Context, before time.Time, batch int) (int64, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.cutoffs = append(f.cutoffs, before)
+	return 0, nil
+}
+
+func (f *fakeStore) calls() []time.Time {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return append([]time.Time(nil), f.cutoffs...)
+}
+
+func TestRunDeletesPeriodically(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		store := &fakeStore{}
+		ctx, cancel := context.WithCancel(t.Context())
+		logger := slog.New(slog.NewTextHandler(io.Discard, nil))
+		start := time.Now()
+
+		done := make(chan struct{})
+		go func() {
+			Run(ctx, store, logger, 24*time.Hour, time.Hour)
+			close(done)
+		}()
+
+		// Once at start, then after 1h and 2h.
+		time.Sleep(2*time.Hour + time.Minute)
+		synctest.Wait()
+		calls := store.calls()
+		if len(calls) != 3 {
+			t.Fatalf("calls = %d, want 3", len(calls))
+		}
+		for i, got := range calls {
+			want := start.Add(time.Duration(i)*time.Hour - 24*time.Hour)
+			if !got.Equal(want) {
+				t.Errorf("call %d: cutoff = %s, want %s", i, got, want)
+			}
+		}
+
+		cancel()
+		<-done
+	})
+}

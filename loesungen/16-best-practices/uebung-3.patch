--- a/internal/sqlitestore/store_test.go
+++ b/internal/sqlitestore/store_test.go
@@ -152,3 +152,46 @@ func TestMigrateIsIdempotent(t *testing.T) {
 		s.Close()
 	}
 }
+
+func TestDeleteResultsBefore(t *testing.T) {
+	s := newStore(t)
+	ctx := t.Context()
+	target := mustCreate(t, s, "https://example.com", time.Minute)
+
+	cutoff := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	// 25 old results and 3 new ones; batch size 10 needs three rounds.
+	for i := range 28 {
+		checkedAt := cutoff.Add(-time.Duration(i+1) * time.Minute)
+		if i >= 25 {
+			checkedAt = cutoff.Add(time.Duration(i) * time.Minute)
+		}
+		if err := s.SaveResult(ctx, monitor.Result{TargetID: target.ID, StatusCode: 200, CheckedAt: checkedAt}); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	n, err := s.DeleteResultsBefore(ctx, cutoff, 10)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n != 25 {
+		t.Errorf("deleted %d, want 25", n)
+	}
+	left, err := s.Results(ctx, target.ID, 100)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(left) != 3 {
+		t.Fatalf("left %d results, want 3", len(left))
+	}
+	for _, r := range left {
+		if r.CheckedAt.Before(cutoff) {
+			t.Errorf("result from %s survived", r.CheckedAt)
+		}
+	}
+
+	// Nothing left to delete: a second run is a no-op.
+	if n, err := s.DeleteResultsBefore(ctx, cutoff, 10); err != nil || n != 0 {
+		t.Errorf("second run = %d, %v; want 0, nil", n, err)
+	}
+}

+
+func TestShutdownDelay(t *testing.T) {
+	for _, tt := range []struct {
+		value   string
+		want    time.Duration
+		wantErr bool
+	}{
+		{"", 0, false},
+		{"0s", 0, false},
+		{"5s", 5 * time.Second, false},
+		{"-1s", 0, true},
+		{"soon", 0, true},
+	} {
+		cfg, err := Load(env(map[string]string{"UPWATCH_SHUTDOWN_DELAY": tt.value}))
+		if (err != nil) != tt.wantErr {
+			t.Errorf("%q: err = %v, wantErr %v", tt.value, err, tt.wantErr)
+			continue
+		}
+		if !tt.wantErr && cfg.ShutdownDelay != tt.want {
+			t.Errorf("%q: ShutdownDelay = %s, want %s", tt.value, cfg.ShutdownDelay, tt.want)
+		}
+	}
+}

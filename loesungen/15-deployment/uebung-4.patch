+func TestReadyzWhileDraining(t *testing.T) {
+	store, err := sqlitestore.Open(t.Context(), filepath.Join(t.TempDir(), "api.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { store.Close() })
+	draining := make(chan struct{})
+	srv := httptest.NewServer(New(store, slog.New(slog.NewTextHandler(io.Discard, nil)), draining))
+	t.Cleanup(srv.Close)
+
+	if resp, body := do(t, "GET", srv.URL+"/readyz", ""); resp.StatusCode != http.StatusOK {
+		t.Fatalf("before drain: /readyz = %d %s, want 200", resp.StatusCode, body)
+	}
+
+	close(draining)
+
+	for _, tt := range []struct {
+		path string
+		want int
+	}{
+		{"/readyz", http.StatusServiceUnavailable},
+		{"/healthz", http.StatusOK}, // still alive: no restart wanted
+		{"/targets", http.StatusOK}, // requests in the drain window are served
+	} {
+		if resp, body := do(t, "GET", srv.URL+tt.path, ""); resp.StatusCode != tt.want {
+			t.Errorf("draining: %s = %d %s, want %d", tt.path, resp.StatusCode, body, tt.want)
+		}
+	}
+}

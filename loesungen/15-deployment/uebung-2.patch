@@ -0,0 +1,27 @@
+package main
+
+import (
+	"runtime/debug"
+	"testing"
+)
+
+func TestBuildSetting(t *testing.T) {
+	info := &debug.BuildInfo{Settings: []debug.BuildSetting{
+		{Key: "vcs", Value: "git"},
+		{Key: "vcs.revision", Value: "836e744d21d2238556f4763e78137b11b90ded39"},
+	}}
+	if got := buildSetting(info, "vcs.revision"); got != "836e744d21d2238556f4763e78137b11b90ded39" {
+		t.Errorf("vcs.revision = %q", got)
+	}
+	if got := buildSetting(info, "vcs.time"); got != "" {
+		t.Errorf("missing key = %q, want empty", got)
+	}
+}
+
+// Test binaries are built without VCS information, so revision is empty
+// here. This is one of the cases the log line has to cope with.
+func TestRevisionEmptyInTests(t *testing.T) {
+	if got := revision(); got != "" {
+		t.Errorf("revision() = %q in a test binary, want empty", got)
+	}
+}

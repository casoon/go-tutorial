+		{"wrong token", "GET", "/targets", "Bearer wrong-token-0123456789", 401},
+		{"prefix of token", "GET", "/targets", "Bearer s3cr3t", 401},
+		{"token plus suffix", "GET", "/targets", "Bearer " + token + "x", 401},
+		{"empty bearer", "GET", "/targets", "Bearer ", 401},
+		{"wrong scheme", "GET", "/targets", "Basic " + token, 401},

diff --git a/internal/httpapi/middleware.go b/internal/httpapi/middleware.go
index 64bb20c..22be251 100644
--- a/internal/httpapi/middleware.go
+++ b/internal/httpapi/middleware.go
@@ -1,7 +1,10 @@
 package httpapi
 
 import (
+	"crypto/sha256"
+	"crypto/subtle"
 	"net/http"
+	"strings"
 	"time"
 )
 
@@ -62,3 +65,32 @@ func securityHeaders(next http.Handler) http.Handler {
 		next.ServeHTTP(w, r)
 	})
 }
+
+// requireToken lets a request through only if it carries
+// "Authorization: Bearer <token>" and answers 401 otherwise.
+//
+// The comparison runs in constant time, so response times do not reveal
+// how many leading bytes of a guess were right. Hashing both sides first
+// gives ConstantTimeCompare equal lengths, which also hides the length of
+// the token. An empty token never matches.
+func requireToken(token string, next http.Handler) http.Handler {
+	want := sha256.Sum256([]byte(token))
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		scheme, got, ok := strings.Cut(r.Header.Get("Authorization"), " ")
+		if !ok || !strings.EqualFold(scheme, "Bearer") || token == "" {
+			unauthorized(w)
+			return
+		}
+		have := sha256.Sum256([]byte(got))
+		if subtle.ConstantTimeCompare(have[:], want[:]) != 1 {
+			unauthorized(w)
+			return
+		}
+		next.ServeHTTP(w, r)
+	})
+}
+
+func unauthorized(w http.ResponseWriter) {
+	w.Header().Set("WWW-Authenticate", `Bearer realm="upwatch"`)
+	writeError(w, http.StatusUnauthorized, "missing or invalid token")
+}

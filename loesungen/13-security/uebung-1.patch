diff --git a/internal/config/config.go b/internal/config/config.go
index da0f121..8033636 100644
--- a/internal/config/config.go
+++ b/internal/config/config.go
@@ -24,8 +24,31 @@ type Config struct {
 	LogLevel     slog.Level    // UPWATCH_LOG_LEVEL (debug, info, warn, error)
 	LogJSON      bool          // UPWATCH_LOG_JSON
 	AllowPrivate bool          // UPWATCH_ALLOW_PRIVATE_TARGETS, for local testing only
+	APIToken     Secret        // UPWATCH_API_TOKEN, empty disables authentication
 }
 
+// Secret is a string that must not leak. slog calls LogValue, fmt calls
+// String and encoding/json calls MarshalText, so neither a log line nor a
+// "%+v" or a JSON dump of Config shows the value. Use string(s) where the
+// real value is needed.
+type Secret string
+
+const redacted = "[redacted]"
+
+// LogValue implements slog.LogValuer.
+func (Secret) LogValue() slog.Value { return slog.StringValue(redacted) }
+
+// String implements fmt.Stringer.
+func (Secret) String() string { return redacted }
+
+// MarshalText implements encoding.TextMarshaler. slog's JSON handler
+// encodes a nested struct such as Config with encoding/json, which
+// ignores LogValue on its fields.
+func (Secret) MarshalText() ([]byte, error) { return []byte(redacted), nil }
+
+// minTokenLength rejects tokens short enough to guess.
+const minTokenLength = 16
+
 // Load reads the configuration via getenv, typically os.Getenv.
 // Passing the lookup function in keeps Load free of global state and
 // trivially testable.
@@ -91,6 +114,15 @@ func Load(getenv func(string) string) (Config, error) {
 	boolean("UPWATCH_LOG_JSON", &cfg.LogJSON)
 	boolean("UPWATCH_ALLOW_PRIVATE_TARGETS", &cfg.AllowPrivate)
 
+	if v := getenv("UPWATCH_API_TOKEN"); v != "" {
+		// Unlike the other messages, this one must not echo the value.
+		if len(v) < minTokenLength {
+			errs = append(errs, fmt.Errorf("UPWATCH_API_TOKEN: want at least %d characters, got %d", minTokenLength, len(v)))
+		} else {
+			cfg.APIToken = Secret(v)
+		}
+	}
+
 	// Report every problem at once instead of one per restart.
 	return cfg, errors.Join(errs...)
 }

+func TestAPIToken(t *testing.T) {
+	const token = "s3cr3t-token-0123456789"
+	cfg, err := Load(env(map[string]string{"UPWATCH_API_TOKEN": token}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(cfg.APIToken) != token {
+		t.Fatalf("APIToken = %q, want the configured value", string(cfg.APIToken))
+	}
+
+	// The token must not appear in logs or in fmt output of the config.
+	var buf bytes.Buffer
+	logger := slog.New(slog.NewJSONHandler(&buf, nil))
+	logger.Info("config", "token", cfg.APIToken, "cfg", cfg)
+	fmt.Fprintf(&buf, "%v %+v %s", cfg.APIToken, cfg, cfg.APIToken)
+	if strings.Contains(buf.String(), token) {
+		t.Errorf("token leaked: %s", buf.String())
+	}
+	if !strings.Contains(buf.String(), "[redacted]") {
+		t.Errorf("want [redacted] in output, got %s", buf.String())
+	}
+}
+
+func TestAPITokenTooShort(t *testing.T) {
+	_, err := Load(env(map[string]string{"UPWATCH_API_TOKEN": "hunter2"}))
+	if err == nil {
+		t.Fatal("expected an error for a short token")
+	}
+	if strings.Contains(err.Error(), "hunter2") {
+		t.Errorf("error leaks the token: %v", err)
+	}
+}

+func TestTargetLimit(t *testing.T) {
+	s := newStore(t)
+	s.maxTargets = 3
+
+	for i := range 3 {
+		mustCreate(t, s, fmt.Sprintf("https://example.com/%d", i), time.Minute)
+	}
+	target, _ := monitor.NewTarget("https://example.com/3", time.Minute)
+	if _, err := s.CreateTarget(t.Context(), target); !errors.Is(err, monitor.ErrLimitReached) {
+		t.Fatalf("4th CreateTarget err = %v, want ErrLimitReached", err)
+	}
+
+	// Deleting a target frees a slot.
+	if err := s.DeleteTarget(t.Context(), 1); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.CreateTarget(t.Context(), target); err != nil {
+		t.Fatalf("CreateTarget after delete: %v", err)
+	}
+}
+
+// TestTargetLimitConcurrent fires more parallel creates than the limit
+// allows. A check-then-insert in two statements would let several of
+// them through; the single INSERT ... SELECT must not.
+func TestTargetLimitConcurrent(t *testing.T) {
+	s := newStore(t)
+	s.maxTargets = 5
+
+	var (
+		wg      sync.WaitGroup
+		mu      sync.Mutex
+		created int
+	)
+	for i := range 30 {
+		wg.Go(func() {
+			target, _ := monitor.NewTarget(fmt.Sprintf("https://example.com/%d", i), time.Minute)
+			_, err := s.CreateTarget(t.Context(), target)
+			switch {
+			case err == nil:
+				mu.Lock()
+				created++
+				mu.Unlock()
+			case !errors.Is(err, monitor.ErrLimitReached):
+				t.Errorf("CreateTarget: %v", err)
+			}
+		})
+	}
+	wg.Wait()
+
+	all, err := s.Targets(t.Context())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if created != 5 || len(all) != 5 {
+		t.Errorf("created %d, stored %d, want 5 and 5", created, len(all))
+	}
+}

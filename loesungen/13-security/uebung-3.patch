+// fullStore behaves like a store that already holds monitor.MaxTargets
+// targets.
+type fullStore struct{ Store }
+
+func (fullStore) CreateTarget(context.Context, monitor.Target) (monitor.Target, error) {
+	return monitor.Target{}, fmt.Errorf("500 targets: %w", monitor.ErrLimitReached)
+}
+
+func TestTargetLimitIsConflict(t *testing.T) {
+	logger := slog.New(slog.NewTextHandler(io.Discard, nil))
+	srv := httptest.NewServer(New(fullStore{}, logger))
+	defer srv.Close()
+
+	resp, body := do(t, "POST", srv.URL+"/targets", `{"url":"https://example.com"}`)
+	if resp.StatusCode != http.StatusConflict {
+		t.Fatalf("status = %d, want 409 (body: %s)", resp.StatusCode, body)
+	}
+	if !strings.Contains(body, "at most 500 targets") {
+		t.Errorf("body = %s", body)
+	}
+}

+// fieldErrors returns every *FieldError in err. errors.As stops at the
+// first match, so the joined error is unwrapped first and each part is
+// checked on its own.
+func fieldErrors(err error) []*FieldError {
+	parts := []error{err}
+	if joined, ok := err.(interface{ Unwrap() []error }); ok {
+		parts = joined.Unwrap()
+	}
+	var out []*FieldError
+	for _, part := range parts {
+		var fe *FieldError
+		if errors.As(part, &fe) {
+			out = append(out, fe)
+		}
+	}
+	return out
+}
+
+func TestLoadCollectsFieldErrors(t *testing.T) {
+	_, err := Load(env(map[string]string{
+		"UPWATCH_WORKERS":   "zero",
+		"UPWATCH_TICK":      "-1s",
+		"UPWATCH_LOG_JSON":  "yes please",
+		"UPWATCH_LOG_LEVEL": "loud", // not a FieldError, must be skipped
+	}))
+
+	var keys []string
+	for _, fe := range fieldErrors(err) {
+		keys = append(keys, fe.Key)
+	}
+	want := []string{"UPWATCH_WORKERS", "UPWATCH_TICK", "UPWATCH_LOG_JSON"}
+	if !slices.Equal(keys, want) {
+		t.Errorf("keys = %v, want %v", keys, want)
+	}
+
+	// The message is unchanged, only the type is new.
+	if !strings.Contains(err.Error(), `UPWATCH_WORKERS: want a positive integer, got "zero"`) {
+		t.Errorf("unexpected message: %v", err)
+	}
+}

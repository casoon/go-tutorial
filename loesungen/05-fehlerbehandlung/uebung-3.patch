+// TestTargetLeaksNoRows documents the effect of wrapping two errors: the
+// domain error and the driver error are both reachable for errors.Is.
+func TestTargetLeaksNoRows(t *testing.T) {
+	s := newStore(t)
+	_, err := s.Target(t.Context(), 99)
+	if !errors.Is(err, monitor.ErrNotFound) {
+		t.Errorf("errors.Is(err, monitor.ErrNotFound) = false, want true")
+	}
+	if !errors.Is(err, sql.ErrNoRows) {
+		t.Errorf("errors.Is(err, sql.ErrNoRows) = false, want true")
+	}
+	t.Log(err)
+}

-// Compile-time proof that *MemStore satisfies both consumer interfaces.
+// ---- Consumer 3: a CSV export, one line per result.
+
+// csvStore happens to list the same methods as reportStore. It is still
+// its own interface: the export and the report may need different things
+// tomorrow, and neither should have to change because of the other.
+type csvStore interface {
+	Targets() []Target
+	Results(targetID int) []int
+}
+
+func WriteCSV(w io.Writer, store csvStore) error {
+	cw := csv.NewWriter(w)
+	for _, t := range store.Targets() {
+		for _, status := range store.Results(t.ID) {
+			if err := cw.Write([]string{t.URL, strconv.Itoa(status)}); err != nil {
+				return err
+			}
+		}
+	}
+	cw.Flush()
+	return cw.Error()
+}
+
+// Compile-time proof that *MemStore satisfies all consumer interfaces.
 // MemStore itself never mentions them.
 var (
 	_ runnerStore = (*MemStore)(nil)
 	_ reportStore = (*MemStore)(nil)
+	_ csvStore    = (*MemStore)(nil)
 )
 
 // ---- Middleware: a function that wraps a Checker in another Checker.
@@ -160,7 +185,10 @@ func run(getenv func(string) string, out io.Writer) error {
 	}), retries)
 
 	NewRunner(store, checker).RunOnce()
-	return WriteReport(out, store)
+	if err := WriteReport(out, store); err != nil {
+		return err
+	}
+	return WriteCSV(out, store)
 }
 

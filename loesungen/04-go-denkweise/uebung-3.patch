+func TestWriteCSV(t *testing.T) {
+	store := NewMemStore("https://a.example", "https://b.example,with-comma")
+	store.SaveResult(1, 200)
+	store.SaveResult(1, 503)
+	store.SaveResult(2, 0)
+
+	var out strings.Builder
+	if err := WriteCSV(&out, store); err != nil {
+		t.Fatal(err)
+	}
+	want := "https://a.example,200\n" +
+		"https://a.example,503\n" +
+		"\"https://b.example,with-comma\",0\n"
+	if out.String() != want {
+		t.Errorf("got\n%s\nwant\n%s", out.String(), want)
+	}
+}

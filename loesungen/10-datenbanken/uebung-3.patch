+func TestMigrationAddsName(t *testing.T) {
+	s := newStore(t)
+	ctx := t.Context()
+	target := mustCreate(t, s, "https://example.com", time.Minute)
+
+	var name string
+	err := s.db.QueryRowContext(ctx,
+		`SELECT name FROM targets WHERE id = ?`, target.ID).Scan(&name)
+	if err != nil {
+		t.Fatalf("select name: %v", err)
+	}
+	if name != "" {
+		t.Errorf("name = %q, want empty default", name)
+	}
+
+	var applied int
+	if err := s.db.QueryRowContext(ctx,
+		`SELECT COUNT(*) FROM schema_migrations`).Scan(&applied); err != nil {
+		t.Fatal(err)
+	}
+	if applied != 2 {
+		t.Errorf("schema_migrations has %d rows, want 2", applied)
+	}
+}

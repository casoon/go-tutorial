+func TestUpdateInterval(t *testing.T) {
+	s := newStore(t)
+	ctx := t.Context()
+	target := mustCreate(t, s, "https://example.com", time.Minute)
+
+	if err := s.UpdateInterval(ctx, target.ID, 5*time.Minute); err != nil {
+		t.Fatalf("UpdateInterval: %v", err)
+	}
+	got, err := s.Target(ctx, target.ID)
+	if err != nil {
+		t.Fatalf("Target: %v", err)
+	}
+	if got.Interval != 5*time.Minute {
+		t.Errorf("Interval = %s, want 5m0s", got.Interval)
+	}
+
+	// Same value again: the row still matches, so this is not ErrNotFound.
+	if err := s.UpdateInterval(ctx, target.ID, 5*time.Minute); err != nil {
+		t.Errorf("UpdateInterval with unchanged value: %v", err)
+	}
+	if err := s.UpdateInterval(ctx, 99, time.Minute); !errors.Is(err, monitor.ErrNotFound) {
+		t.Errorf("UpdateInterval(99) err = %v, want ErrNotFound", err)
+	}
+}

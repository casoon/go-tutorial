+
+// timeoutChecker pretends every check runs into its timeout after 100ms.
+type timeoutChecker struct{}
+
+func (timeoutChecker) Check(ctx context.Context, t monitor.Target) (monitor.Result, error) {
+	select {
+	case <-time.After(100 * time.Millisecond):
+		return monitor.Result{TargetID: t.ID, Err: "timeout"}, nil
+	case <-ctx.Done():
+		return monitor.Result{}, ctx.Err()
+	}
+}
+
+func TestTimeoutsAreCounted(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		store := &fakeStore{pending: []monitor.Target{{ID: 1}, {ID: 2}, {ID: 3}}}
+		// expvar counters are process-wide: compare deltas.
+		timeoutsBefore, downBefore := checksTimeout.Value(), checksDown.Value()
+
+		ctx, cancel := context.WithCancel(t.Context())
+		s := New(store, timeoutChecker{}, discardLogger(), 3, time.Second)
+		done := make(chan struct{})
+		go func() {
+			s.Run(ctx)
+			close(done)
+		}()
+
+		time.Sleep(100 * time.Millisecond)
+		synctest.Wait()
+		cancel()
+		<-done
+
+		if got := checksTimeout.Value() - timeoutsBefore; got != 3 {
+			t.Errorf("upwatch_checks_timeout_total grew by %d, want 3", got)
+		}
+		// A timeout is also a down check.
+		if got := checksDown.Value() - downBefore; got != 3 {
+			t.Errorf("upwatch_checks_down_total grew by %d, want 3", got)
+		}
+	})
+}
